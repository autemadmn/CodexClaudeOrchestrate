{
  "$id": "tasks_plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks", "parallelization_notes", "risks", "needs_escalation", "escalation_reason"],
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "priority", "dependencies", "allowed_files", "context_files", "acceptance_criteria", "test_commands", "forbidden", "approval_category"],
        "properties": {
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 10 },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "allowed_files": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "context_files": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "test_commands": { "type": "array", "items": { "type": "string" } },
          "forbidden": { "type": "array", "items": { "type": "string" } },
          "approval_category": { "type": "string", "enum": ["AUTO_APPROVED", "REQUIRES_BRAIN_APPROVAL", "REQUIRES_HUMAN_APPROVAL"] }
        }
      }
    },
    "parallelization_notes": { "type": "string" },
    "risks": { "type": "array", "items": { "type": "string" } },
    "needs_escalation": { "type": "boolean" },
    "escalation_reason": { "type": "string" }
  }
}
