{
  "$id": "manager_summary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "status", "result", "tasks_completed", "tasks_failed", "tests", "blockers", "risks", "decisions_needed", "recommendation"],
  "properties": {
    "objective": { "type": "string" },
    "status": { "type": "string", "enum": ["SUCCESS", "PARTIAL", "BLOCKED"] },
    "result": { "type": "string" },
    "tasks_completed": { "type": "integer" },
    "tasks_failed": { "type": "integer" },
    "tests": { "type": "string" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "decisions_needed": { "type": "array", "items": { "type": "string" } },
    "recommendation": { "type": "string" }
  }
}
